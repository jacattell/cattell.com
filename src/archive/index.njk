---
title: Social media archive
description: Search everything I've posted on Bluesky, Mastodon and X (Twitter).
---
<p>Everything I've posted on social media, in one place. Posts I shared on more than one platform appear once, with links to each.</p>
<p class="hint">{{ archive.items.length | number }} posts, from {% for s in archive.sources %}{{ s.count | number }} on {{ s.name }}{% if loop.revindex == 2 %} and {% elif not loop.last %}, {% endif %}{% endfor %}. LinkedIn is coming soon.</p>

<form id="archive-search" class="archive-search" role="search" hidden>
  <label for="archive-q">Search posts</label>
  <input id="archive-q" type="search" autocomplete="off">
  <fieldset>
    <legend class="visually-hidden">Filters</legend>
    {%- for s in archive.sources %}
    <label><input type="checkbox" name="platform" value="{{ s.key }}" checked> {{ s.name }}</label>
    {%- endfor %}
    <label><input type="checkbox" name="replies"> Include replies to other people</label>
  </fieldset>
</form>
<p id="archive-status" class="hint" role="status"></p>
<div id="archive-results"></div>
<button type="button" id="archive-more" class="secondary" hidden>Show more</button>

<div id="archive-browse">
  <h2>Browse by year</h2>
  <ul class="years-list">
    {%- for y in archive.years %}
    <li><a href="/archive/{{ y.year }}/">{{ y.year }}</a> <span class="hint">({{ y.items.length | number }})</span></li>
    {%- endfor %}
  </ul>
  <h2>Latest posts</h2>
  {%- for item in archive.items | rejectattr("reply") | batch(20) | first %}
  {% include "archive-post.njk" %}
  {%- endfor %}
</div>
<script src="{{ '/assets/js/archive.js' | versioned }}" defer></script>
