<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = noteTitle or title %}
  <title>{% if pageTitle and pageTitle != site.title %}{{ pageTitle }} - {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ summary or description or site.description }}">
  {#- The editor's Content-Security-Policy allows this script by its hash (see _headers.njk). #}
  <script>{% include "theme-inline.js" %}</script>
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | versioned }}">
  <script src="{{ '/assets/js/theme.js' | versioned }}" defer></script>
  <script src="{{ '/assets/js/share.js' | versioned }}" defer></script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="Week notes" href="/week-notes/feed.xml">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- if noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <div class="wrap">
      <div class="header-top">
        <a class="site-name" href="/">{{ site.title }}</a>
        <div class="header-buttons">
          {#- Icons drawn to match "Black and white level" and "Black and white adjustment" by icon 54 (Noun Project). #}
          <button type="button" class="icon-button theme-toggle" aria-label="Dark mode" aria-pressed="false" title="Dark mode" hidden>
            <svg width="31" height="31" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
              <circle cx="16" cy="16" r="14.5" fill="none" stroke="currentColor" stroke-width="3"/>
              <path class="half-normal" d="M26.6 5.4 A15 15 0 0 1 5.4 26.6 Z" fill="currentColor"/>
              <path class="half-negative" d="M26.6 5.4 A15 15 0 0 0 5.4 26.6 Z" fill="currentColor"/>
            </svg>
          </button>
          <button type="button" class="icon-button text-size" aria-label="Make text bigger" title="Make text bigger" hidden>
            <svg width="31" height="31" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
              <rect x="1.5" y="1.5" width="29" height="29" rx="3.5" fill="none" stroke="currentColor" stroke-width="3"/>
              <path d="M30 2 V30 H2 Z" fill="currentColor"/>
              <path d="M6.5 9.5 H12.5 M9.5 6.5 V12.5" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
              <path class="minus" d="M19.5 22.5 H25.5" fill="none" stroke-width="2.4" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>
      <nav aria-label="Main">
        <ul>
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="{{ 'page' if page.url == item.url else 'true' }}"{% endif %}>{{ item.text }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" class="wrap">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <ul class="footer-icons">
        <li><a href="/contact/"><img class="icon-on-light" src="/assets/icons/email-black.png" alt="Contact me" width="31" height="31"><img class="icon-on-dark" src="/assets/icons/email-white.png" alt="Contact me" width="31" height="31"></a></li>
        <li><a href="https://bsky.app/profile/jacattell.bsky.social"><img src="/assets/icons/bluesky.png" alt="Bluesky" width="31" height="31"></a></li>
        <li><a href="https://www.linkedin.com/in/jacattell/"><img src="/assets/icons/linkedin.png" alt="LinkedIn" width="31" height="31"></a></li>
        <li><a href="https://mastodon.me.uk/@jacattell" rel="me"><img src="/assets/icons/mastodon.png" alt="Mastodon" width="31" height="31"></a></li>
        <li><a href="https://x.com/jaCattell"><img class="icon-on-light" src="/assets/icons/x-black.png" alt="X (Twitter)" width="31" height="31"><img class="icon-on-dark" src="/assets/icons/x-white.png" alt="X (Twitter)" width="31" height="31"></a></li>
        <li><a href="https://www.youtube.com/@jacattell"><img src="/assets/icons/youtube.png" alt="YouTube" width="31" height="31"></a></li>
        <li><a href="{{ page.inputPath | githubSource }}"><img class="icon-on-light" src="/assets/icons/github-black.png" alt="Source on GitHub" width="31" height="31"><img class="icon-on-dark" src="/assets/icons/github-white.png" alt="Source on GitHub" width="31" height="31"></a></li>
        <li><a href="/week-notes/feed.xml"><img src="/assets/icons/rss.png" alt="Week notes feed (RSS)" width="31" height="31"></a></li>
      </ul>      <div class="footer-legal">
        <p>© {{ site.author }}. All content is available under the <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">Creative Commons BY-SA 4.0</a> licence, except where otherwise stated</p>
        <p>Light/dark and text size icons based on <a href="https://thenounproject.com/icon/black-and-white-level-1502125/">Black and white level</a> and <a href="https://thenounproject.com/icon/black-and-white-adjustment-1502126/">Black and white adjustment</a> by icon 54 from Noun Project (<a href="https://creativecommons.org/licenses/by/3.0/">CC BY 3.0</a>)</p>
      </div>
    </div>
  </footer>
  {%- if page.url != "/404.html" and not noindex %}
  {% include "share.njk" %}
  {%- endif %}
</body>
</html>
