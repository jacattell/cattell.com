<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = noteTitle or title %}
  <title>{% if pageTitle and pageTitle != site.title %}{{ pageTitle }} - {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ summary or description or site.description }}">
  <script>
    // Apply a saved light/dark choice before the page is drawn, so it does not flash.
    try { var t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="stylesheet" href="{{ '/assets/css/site.css' | versioned }}">
  <script src="{{ '/assets/js/theme.js' | versioned }}" defer></script>
  <script src="{{ '/assets/js/share.js' | versioned }}" defer></script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="Week notes" href="/week-notes/feed.xml">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
</head>
<body>
  <a class="skip" href="#main">Skip to main content</a>
  <header class="site-header">
    <div class="wrap">
      <div class="header-top">
        <a class="site-name" href="/">{{ site.title }}</a>
        <button type="button" class="theme-toggle" hidden>Dark mode</button>
      </div>
      <nav aria-label="Main">
        <ul>
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url.startsWith(item.url) %} aria-current="{{ 'page' if page.url == item.url else 'true' }}"{% endif %}>{{ item.text }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>
  </header>
  <main id="main" class="wrap">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="wrap">
      <p class="footer-links"><a href="/contact/">Contact me</a> <span class="sep" aria-hidden="true">·</span> <a href="/week-notes/feed.xml">Week notes feed</a> <span class="sep" aria-hidden="true">·</span> <a href="{{ page.inputPath | githubSource }}">Source on GitHub</a></p>
      <div class="footer-legal">
        <p>© {{ site.author }}. All content is available under the <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="license">Creative Commons BY-SA 4.0</a> licence, except where otherwise stated</p>
      </div>
    </div>
  </footer>
  {%- if page.url != "/404.html" %}
  {% include "share.njk" %}
  {%- endif %}
</body>
</html>
