---
layout: layouts/base.njk
---
{%- if page.url != "/unconference/" %}<p class="crumb"><a href="/unconference/">Unconference</a></p>{% endif %}
<h1>{{ title }}</h1>
{{ content | safe }}
{%- if bookOrder !== undefined %}
{%- set prev = collections.unconferenceBook | getPreviousCollectionItem %}
{%- set next = collections.unconferenceBook | getNextCollectionItem %}
<nav class="pager" aria-label="Unconference chapters">
  {%- if prev %}<a class="prev" href="{{ prev.url }}" rel="prev"><span>Previous</span> {{ prev.data.title }}</a>{% endif %}
  {%- if next %}<a class="next" href="{{ next.url }}" rel="next"><span>Next</span> {{ next.data.title }}</a>{% endif %}
</nav>
{%- endif %}
{%- if page.url == "/unconference/" %}
<h2>Chapters</h2>
<ol>
  {%- for ch in collections.unconferenceBook %}
  {%- if ch.url != "/unconference/" %}<li><a href="{{ ch.url }}">{{ ch.data.title }}</a></li>{% endif %}
  {%- endfor %}
</ol>
{%- if collections.unconferencePosts.length %}
<h2>Blog posts</h2>
<ul>
  {%- for post in collections.unconferencePosts %}
  <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
  {%- endfor %}
</ul>
{%- endif %}
{%- endif %}
