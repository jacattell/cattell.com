---
layout: layouts/base.njk
---
{%- if title %}<h1>{{ title }}</h1>{% else %}<h1 class="visually-hidden">{{ site.title }}</h1>{% endif %}
{{ content | safe }}
{%- for note in collections.weekNotes.slice(-3).reverse() %}
<h2><a href="{{ note.url }}">{{ note.data.noteTitle }}</a></h2>
<p>{{ note.templateContent | stripTags | preview(280) }}</p>
{%- endfor %}
