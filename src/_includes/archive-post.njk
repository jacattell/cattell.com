{#- One archive item. Keep in step with render() in src/assets/js/archive.js. -#}
<article class="post">
  <p class="post-meta"><time datetime="{{ item.date }}">{{ item.date | archiveDate }}</time>{% if item.reply %} · Reply{% elif item.thread %} · Thread{% endif %}</p>
  <div class="post-text">{{ item.text | postHtml | safe }}</div>
  {%- set pictures = item.images | selectattr("thumb") %}
  {%- if pictures.length %}
  <div class="post-images">
    {%- for img in pictures %}
    <a href="{{ img.url }}"><img src="{{ img.thumb }}" alt="{{ img.alt or 'Image without a description' }}" loading="lazy" decoding="async" referrerpolicy="no-referrer"></a>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- if item.videos.length %}
  <div class="post-videos">
    {%- for v in item.videos %}
    <a class="yt{% if v.short %} yt-short{% endif %}" href="https://www.youtube.com/watch?v={{ v.id }}" data-id="{{ v.id }}"><img src="{{ v.thumb }}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer"><span class="yt-play">▶ Play video<span class="visually-hidden"> from YouTube</span></span></a>
    {%- endfor %}
  </div>
  {%- endif %}
  {%- for img in item.images | rejectattr("thumb") %}
  <p class="post-media">{% if img.url %}<a href="{{ img.url }}">{{ "Video" if img.video else "Image" }}</a>{% else %}<a href="{{ item.on[0].url }}">{{ "Video" if img.video else "Image" }}</a>{% endif %}{% if img.alt %}: {{ img.alt }}{% endif %}</p>
  {%- endfor %}
  {%- if item.link and (item.link.url not in item.text) %}
  <p class="post-media">Link: <a href="{{ item.link.url }}">{{ item.link.title or item.link.url }}</a></p>
  {%- endif %}
  {%- if item.quote %}
  <p class="post-media">Quoting <a href="{{ item.quote }}">another post</a></p>
  {%- endif %}
  <p class="post-on">On {% for o in item.on %}<a href="{{ o.url }}">{{ archive.platforms[o.platform] }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>
</article>
