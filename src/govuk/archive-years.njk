---
# GOV.UK version of the social media archive's year pages (the main site's are in src/archive/year.njk).
pagination:
  data: archive.years
  size: 1
  alias: y
permalink: "/govuk/archive/{{ y.year }}/"
layout: layouts/govuk.njk
eleventyExcludeFromCollections: true
eleventyComputed:
  p:
    url: "/archive/{{ y.year }}/"
    data:
      title: "Social media archive: {{ y.year }}"
---
<p class="crumb"><a href="/archive/">Social media archive</a></p>
<h1>{{ y.year }}</h1>
<p class="hint">{{ y.items.length }} posts, newest first.</p>
{%- for item in y.items %}
{% include "archive-post.njk" %}
{%- endfor %}
<script src="{{ '/assets/js/archive.js' | versioned }}" defer></script>
