// cattell-public: https://api.cattell.com (contact and feedback forms). See README.md, "Switching over".
// Secrets (Cloudflare → Workers → cattell-public → Settings → Variables and Secrets), never here:
//   RESEND_API_KEY, FORM_TO, TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY
{
  "name": "cattell-public",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.cattell.com", "custom_domain": true }],
  "observability": { "enabled": true, "redact_query_string": true, "logs": { "invocation_logs": false } },
  "vars": {
    "SITE": "https://www.cattell.com",
    "API_HOST": "api.cattell.com"
  },
  // Firm per-visitor limits, shared by every copy of the Worker.
  "ratelimits": [
    { "name": "FORM_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ]
}
