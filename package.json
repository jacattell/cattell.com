{
  "name": "cattell.com",
  "version": "2.0.0",
  "private": true,
  "description": "James Arthur Cattell's personal website",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/prepare.mjs && hugo server",
    "test": "node scripts/build.mjs && node --test \"test/*.test.js\"",
    "admin:css": "node scripts/admin-css.mjs",
    "archive:fetch": "node scripts/archive/fetch-bluesky.js && node scripts/archive/fetch-mastodon.js && npm --prefix scripts run fetch-media"
  }
}
