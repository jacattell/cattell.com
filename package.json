{
  "name": "cattell.com",
  "version": "1.0.0",
  "private": true,
  "description": "James Arthur Cattell's personal website",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "eleventy",
    "dev": "eleventy --serve",
    "preview": "npm run build && wrangler pages dev",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "archive:fetch": "node scripts/archive/fetch-bluesky.js && node scripts/archive/fetch-mastodon.js"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@anthropic-ai/sdk": "^1.7.0"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}
