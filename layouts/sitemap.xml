{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range site.Pages }}{{ if not (or .Params.noindex (hasPrefix .RelPermalink "/hidden/") (hasPrefix .RelPermalink "/archive/2") (hasPrefix .RelPermalink "/archive/1")) }}
  <url><loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}<lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>{{ end }}</url>
  {{- end }}{{ end }}
</urlset>
