{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en-GB">
  <title>{{ site.Title }}: week notes</title>
  <link href="{{ .Permalink }}"/>
  <link rel="self" href="{{ (.OutputFormats.Get "atom").Permalink }}"/>
  <id>{{ .Permalink }}</id>
  <author><name>{{ site.Params.author }}</name></author>
  {{- $notes := (where site.RegularPages "Section" "week-notes").ByDate.Reverse }}
  {{- with index $notes 0 }}<updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>{{ end }}
  {{- range first 20 $notes }}
  <entry>
    <title>{{ .Title }}{{ with .Params.summary }}: {{ . }}{{ end }}</title>
    <link href="{{ .Permalink }}"/>
    <id>{{ .Permalink }}</id>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    <content type="html">{{ .Content | absURL | html }}</content>
  </entry>
  {{- end }}
</feed>
